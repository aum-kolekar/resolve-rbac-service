# ── Server ────────────────────────────────────────────────────────────────
PORT=4300
NODE_ENV=development
LOG_LEVEL=info

# ── Postgres (system of record — Contracts/RBAC_Service.md §4) ─────────────
DATABASE_URL=postgres://rbac:rbac@localhost:5432/rbac_service

# ── Redis (pure cache, never source of truth — Contract §10) ───────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=resolve:rbac:
PERMISSION_CACHE_TTL_SECONDS=60

# ── Authentication Service dependency (JWT verification, Contract §3) ──────
# When USE_MOCK_JWKS=true, points at the local mock JWKS server (mocks/server.js,
# started via `npm run mocks`) instead of a real running Authentication Service,
# so this service can be built/tested standalone. Flip to false + point at the
# real Authentication Service once both are running together.
USE_MOCK_JWKS=true
AUTHENTICATION_SERVICE_URL=http://localhost:4400
INTERNAL_SERVICE_TOKEN=dev-internal-service-token
